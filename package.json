{
  "name": "infinity-water-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm run build && npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1",
    "postcss-selector-parser": "6.1.3",
    "minimatch@<4": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@>=9 <10": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.9"
    }
  }
